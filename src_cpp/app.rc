#include <windows.h>

101 ICON "app.ico"

1 VERSIONINFO
FILEVERSION     1,3,0,0
PRODUCTVERSION  1,3,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName",      "DeskFolder"
            VALUE "FileDescription",  "桌面图标文件夹"
            VALUE "FileVersion",      "1.3.0.0"
            VALUE "InternalName",     "DeskFolder"
            VALUE "OriginalFilename", "DeskFolder.exe"
            VALUE "ProductName",      "DeskFolder"
            VALUE "ProductVersion",   "1.3.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END
